{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toksec security evaluation contract version 1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "security"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^release/[0-9]{6}$"
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "tag",
        "commit",
        "source_sha256"
      ],
      "additionalProperties": false
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toksec_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "toksec_dirty": {
      "type": "boolean"
    },
    "run_toksec_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_utc": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "error"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "informational",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "unconfirmed"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "severity",
          "status",
          "description",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "evaluation_id",
    "run_id",
    "release",
    "contract_sha256",
    "evaluator_sha256",
    "toksec_commit",
    "toksec_dirty",
    "run_toksec_commit",
    "created_utc",
    "environment",
    "status",
    "scope",
    "methods",
    "limitations",
    "findings",
    "artifacts"
  ],
  "additionalProperties": false
}
